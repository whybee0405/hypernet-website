# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string
DATABASE_URI=file:./hypernet.db

# Public site URL (used for canonical URLs, OG tags, sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Seed script guard
SEED_ADMIN_EMAIL=hello@hypernet.co.za
SEED_ADMIN_PASSWORD=ChangeMe123!
PREVIEW_SECRET=replace-with-a-random-string

# --- Docker (read by compose.yaml) -----------------------------------------
# Host port. 3060 is clear of the other projects on this Docker Desktop.
HYPERNET_PORT=3060
# Must match the port above. Inlined into the client bundle at build time, so
# changing it needs a rebuild rather than just a restart.
HYPERNET_PUBLIC_URL=http://localhost:3060
# Long random strings, separate from the local development ones above.
HYPERNET_PAYLOAD_SECRET=change-me-to-a-long-random-string
HYPERNET_PREVIEW_SECRET=change-me-to-a-different-long-random-string
# Used only on first start, to create the admin user in the container.
HYPERNET_ADMIN_EMAIL=hello@hypernet.co.za
HYPERNET_ADMIN_PASSWORD=change-me-before-first-run
